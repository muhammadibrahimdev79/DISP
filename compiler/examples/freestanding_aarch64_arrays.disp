fn array_pick(seed: u8, depth: u8) -> u8 {
    var bytes: [u8; 4] = [seed, u8(2), u8(3), u8(4)]
    bytes[1] += 5
    if depth == 0 {
        return bytes[1]
    }
    return array_pick(bytes[0], depth - 1)
}

fn main() {
    print("AArch64 checked fixed arrays")

    var values: [u32; 4] = [u32(10), u32(20), u32(30), u32(40)]
    var index: u32 = 2
    values[index] += 5
    print(values[index])
    print(array_pick(u8(9), u8(2)))

    var words: [u16; 2] = [u16(60000), u16(2)]
    words[0] /= 3
    print(words[0])

    var signed: [i32; 2] = [i32(-1), i32(-2)]
    signed[1] *= 21
    print(signed[1])

    var flags: [bool; 2] = [true, false]
    flags[1] = true
    print(flags[1])
}
