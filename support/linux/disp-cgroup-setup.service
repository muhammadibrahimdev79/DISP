[Unit]
Description=Prepare the trusted DISP cgroup v2 subtree
Documentation=https://github.com/muhammadibrahimdev79/DISP
DefaultDependencies=no
After=local-fs.target
Before=multi-user.target
ConditionPathExists=/sys/fs/cgroup/cgroup.controllers

[Service]
Type=oneshot
ExecStart=/usr/libexec/disp-cgroup-setup
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
